{
  "name": "thenewforeignassistance",
  "version": "1.0.0",
  "private": true,
  "description": "Static site for thenewforeignassistance.org (GitHub Pages)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "tailwindcss": "^3.4.17"
  }
}
